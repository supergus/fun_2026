# Copy to .env (git-ignored) or export these in your shell. Never commit real values.

# --- Email (SMTP) ---
# Gmail: use an App Password, https://support.google.com/accounts/answer/185833
FUN_SMTP_HOST=smtp.gmail.com
FUN_SMTP_PORT=587
FUN_SMTP_USER=you@gmail.com
FUN_SMTP_PASSWORD=your-app-password
FUN_SMTP_FROM=you@gmail.com
# FUN_SMTP_STARTTLS=true
# Optional image embedded at the bottom of HTML emails
# FUN_EMAIL_LOGO_FILE=/path/to/logo.png

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15555550123

# --- Push (ntfy) ---
FUN_NTFY_SERVER=https://ntfy.sh
# Default topic used when a recipient has no ntfy_topic in contact_list.json
FUN_NTFY_TOPIC=pick-a-long-unguessable-topic
# FUN_NTFY_TOKEN=tk_xxxxxxxx
